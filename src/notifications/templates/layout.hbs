<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{{subject}}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    }
    hr {
      border: 1px solid #007BFF; 
      width: 95%; 
      margin: 20px auto;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    .content {
      padding: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    {{> header}} 
    <div class="content">
      {{{body}}}
    </div>
    {{> footer}} 
  </div>
</body>
</html>
